{
    "model": "kimi-for-coding",
    "max_context_size": 1048576,
    "capabilities": [
        "thinking",
        "image_in"
    ],
    "url": "https://api.kimi.com/coding/v1",
    "type": "kimi",
    "api_key": "sk-xxx",
    "custom_headers": {},
    "oauth": {
        "storage": "file",
        "key": "oauth/kimi-code"
    },
    "env": {},
    "services": {
        "search": {
            "base_url": "https://api.kimi.com/v1/search",
            "api_key": "sk-xxx"
        },
        "fetch": {
            "base_url": "https://api.kimi.com/v1/fetch",
            "api_key": "sk-xxx"
        }
    },
    "max_tokens": 131072,
    "thinking_effort": "max",
    "show_thinking_stream": true,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 50,
    "loop_control": {
        "max_steps_per_turn": 5000,
        "max_retries_per_step": 3,
        "reserved_context_size": 50000,
        "compaction_trigger_ratio": 0.85
    },
    "notifications": {
        "enabled": true,
        "sound": true,
        "desktop": true
    },
    "mcp": {
        "enabled": true,
        "servers": []
    },
    "sub_providers": [
        {
            "role": "sub_agent",
            "model": "kimi-for-coding",
            "max_context_size": 1048576,
            "capabilities": ["thinking", "image_in"],
            "url": "https://api.kimi.com/coding/v1",
            "type": "kimi",
            "api_key": "sk-xxx"
        }
    ]
}
